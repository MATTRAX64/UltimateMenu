  <ItemGroup>
    <EmbeddedResource Remove="Assets/**/*"/>
    <EmbeddedResource Include="Assets/**/*" Exclude="Assets/**/*.cs;Assets/**/*.shader;Assets/**/*.meta">
      <LogicalName>UltimateMenu.$([System.String]::Copy('%(Identity)').Replace('\', '.').Replace('/', '.'))</LogicalName>
      <WithCulture>false</WithCulture>
      <Type>Non-Resx</Type>
    </EmbeddedResource>
  </ItemGroup>

  <UsingTask TaskName="PackMenuTranslations" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Catalogs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        var resources = new List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var catalog in Catalogs)
        {
            string source = catalog.GetMetadata("FullPath");
            string name = Path.GetFileName(source) + ".gz";
            string output = Path.Combine(OutputDirectory, name);
            using (var input = File.OpenRead(source))
            using (var file = File.Create(output))
            using (var gzip = new GZipStream(file, CompressionLevel.Optimal)) input.CopyTo(gzip);
            var item = new Microsoft.Build.Utilities.TaskItem(output);
            item.SetMetadata("LogicalName", "UltimateMenu.Assets.Menu.Translations." + name);
            item.SetMetadata("WithCulture", "false");
            item.SetMetadata("Type", "Non-Resx");
            resources.Add(item);
        }
        Resources = resources.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrepareMenuTranslations" BeforeTargets="AssignTargetPaths">
    <ItemGroup><_MenuCatalog Include="Translations/*.json" /></ItemGroup>
    <PackMenuTranslations Catalogs="@(_MenuCatalog)" OutputDirectory="$(IntermediateOutputPath)MenuTranslations">
      <Output TaskParameter="Resources" ItemName="EmbeddedResource" />
    </PackMenuTranslations>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipPluginDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag\BepInEx\plugins\UltimateMenu\UltimateMenu v$(Version).dll" />
  </Target>

